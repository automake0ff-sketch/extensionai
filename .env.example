# --- Firebase (client SDK) -------------------------------------------------
# Project settings -> General -> "Your apps" -> SDK setup and configuration,
# in the Firebase console. These are public by Firebase's own design (they
# identify your project, they don't grant access) so the NEXT_PUBLIC_ prefix
# is intentional — Firestore/Auth security rules are what actually protect
# data, not secrecy of these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server-only) --------------------------------------
# Project settings -> Service accounts -> Generate new private key. Never
# expose these to the browser or commit real values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key field from the downloaded JSON. If you set this in a
# .env file, keep the literal \n sequences — the app converts them back to
# real newlines at startup.
FIREBASE_PRIVATE_KEY=

# --- App-level encryption (server-only) ------------------------------------
# Used to encrypt secrets ExtenAI stores on your behalf (currently: the
# GitHub OAuth access token) before writing them to Firestore. Generate a
# real one with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# --- AI provider ------------------------------------------------------------
# Which lib/ai provider implementation to use. Currently: "anthropic".
AI_PROVIDER=anthropic
# Server-only secret for the configured provider.
AI_API_KEY=
# Optional: override the default model for the provider.
AI_MODEL=claude-sonnet-4-6
# Optional: only needed if AI_API_KEY is an organization-level key rather
# than one scoped to a specific workspace (the API rejects org-level keys
# with a 400 error unless this header is present). Find it in the Anthropic
# Console under the workspace's settings. Leave unset if your key already
# works without it — most workspace-scoped keys do.
ANTHROPIC_WORKSPACE_ID=

# --- GitHub export (repo/commit creation, not "Sign in with GitHub") ------
# Create an OAuth App at https://github.com/settings/developers with
# callback URL <your-app-url>/api/github/callback, then set:
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Stripe (billing) -------------------------------------------------------
# Dashboard -> Developers -> API keys, and -> Webhooks for the signing
# secret once you've registered POST /api/billing/webhook as an endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs (not product IDs) for the Pro and Pro+ recurring prices,
# from Dashboard -> Product catalog.
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_PLUS=
